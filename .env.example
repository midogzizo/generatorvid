# ===== مشروع MCP Media Generator (mcp-app/) — Vercel → Settings → Environment Variables =====
# قاعدة Turso (إلزاميان). أنشئ القاعدة والتوكن:
#   turso db create <name>
#   turso db show <name> --url
#   turso db tokens create <name>
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# عنوان خدمة الدمج بعد نشر مشروع merger على Vercel
MERGER_API_BASE=

# اختياري
# إن ضُبط يُطلب Bearer token على /mcp
MCP_ACCESS_TOKEN=
# تجاوز أسماء الموديلات إن لزم
KIE_IMAGE_MODEL=
KIE_VIDEO_MODEL=
COMETAPI_IMAGE_MODEL=
COMETAPI_VIDEO_MODEL=

# ===== مشروع Video Merger (merger/) — نفس المتغيرين الأولين فقط =====
# عنوان النطاق العام لضبط روابط statusUrl/processUrl/videoUrl
MERGER_PUBLIC_BASE=
# الحدود القابلة للضبط
MAX_SOURCES=10
SOURCE_MAX_MB=200
OUTPUT_MAX_MB=150
MAX_TOTAL_DURATION_SEC=600
FFMPEG_PRESET=medium
